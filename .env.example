# Sepolia Testnet Configuration
# Copy this file to .env and fill in your values

# Your Sepolia testnet RPC URL
# You can use:
# - Free public RPC: https://rpc.sepolia.org
# - Infura: https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# - Alchemy: https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Your MetaMask private key (NEVER commit this!)
# Get from MetaMask: Account details → Export Private Key
# Format: 0x followed by 64 hex characters
PRIVATE_KEY=0x

# MetaMask wallet allowed to authenticate as Admin.
# This must match admin() in the deployed smart contract.
ADMIN_ADDRESS=0x

# Secret used to sign short-lived local Admin sessions.
ADMIN_TOKEN_SECRET=replace-with-a-long-random-value

# Network Chain ID (DO NOT CHANGE)
CHAIN_ID=11155111
